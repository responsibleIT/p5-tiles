new p5(function(p) {

  const W = 1080, H = 920;
  let mx = W / 2, my = H / 2;
  let targetMx = W / 2, targetMy = H / 2;

  const palette = [
    [240,  80,  80],  // red
    [245, 110,  60],  // red-orange
    [250, 150,  50],  // orange
    [255, 200,  60],  // amber
    [240, 230,  80],  // yellow
    [180, 220,  90],  // yellow-green
    [100, 200, 150],  // teal-green
    [ 70, 185, 170],  // teal
    [ 90, 170, 190],  // teal-blue
    [160, 160, 210],  // lavender
    [200, 130, 180],  // pink-lavender
    [230,  90, 130],  // pink-red
  ];

  const COUNT = 28;

  const triangles = Array.from({ length: COUNT }, () => {
    const hx = (Math.random() - 0.5) * (W * 0.92);
    const hy = (Math.random() - 0.5) * (H * 0.92);

    const sizeRoll = Math.random();
    const radius = sizeRoll < 0.25
      ? 260 + Math.random() * 160
      : sizeRoll < 0.6
      ? 120 + Math.random() * 120
      :  50 + Math.random() * 80;

    const colIdx = Math.floor(Math.random() * palette.length);

    return {
      hx, hy,
      radius,
      col: palette[colIdx],
      alpha: 200 + Math.random() * 55,
      baseAngle: Math.random() * Math.PI * 2,
      rotSpeed: (Math.random() - 0.5) * 0.025,
      phase: Math.random() * Math.PI * 2,
      driftAmp: 8 + Math.random() * 18,
      driftFreqX: 0.4 + Math.random() * 0.5,
      driftFreqY: 0.3 + Math.random() * 0.5,
      mouseStrength: 15 + Math.random() * 55,
      mouseLag: 0.025 + Math.random() * 0.055,
      ox: 0, oy: 0,
    };
  });

  function triPts(cx, cy, r, angle) {
    let pts = [];
    for (let i = 0; i < 3; i++) {
      let a = angle + (i * p.TWO_PI / 3) - p.HALF_PI;
      pts.push({ x: cx + r * p.cos(a), y: cy + r * p.sin(a) });
    }
    return pts;
  }

  function drawSharpTriangle(cx, cy, r, angle, col, alpha) {
    let pts = triPts(cx, cy, r, angle);

    // Filled triangle with slight transparency
    p.fill(col[0], col[1], col[2], alpha * 0.35);
    p.stroke(col[0], col[1], col[2], alpha);
    p.strokeWeight(2.5);
    p.beginShape();
    for (let pt of pts) p.vertex(pt.x, pt.y);
    p.endShape(p.CLOSE);

    // Single tight glow ring — just 3 steps, very close
    p.noFill();
    for (let b = 3; b >= 1; b--) {
      let a = p.map(b, 3, 0, alpha * 0.25, 0);
      p.stroke(col[0], col[1], col[2], a);
      p.strokeWeight(b * 3);
      p.beginShape();
      for (let pt of pts) p.vertex(pt.x, pt.y);
      p.endShape(p.CLOSE);
    }
  }

  let t = 0;

  p.setup = function () {
    p.createCanvas(W, H);
    p.colorMode(p.RGB, 255, 255, 255, 255);
    p.smooth();
  };

  p.mouseMoved = function () {
    targetMx = p.mouseX;
    targetMy = p.mouseY;
  };

  p.draw = function () {
    t += 0.012;

    mx += (targetMx - mx) * 0.06;
    my += (targetMy - my) * 0.06;

    // Warm peachy background matching the image
    p.background(245, 175, 110);

    // Subtle corner color washes
    let corners = [
      { x: 0,   y: 0,   col: [240, 80,  80],  r: 500 },   // top-left red
      { x: W,   y: 0,   col: [255, 200, 60],  r: 450 },   // top-right yellow
      { x: 0,   y: H,   col: [160, 160, 210], r: 480 },   // bottom-left lavender
      { x: W,   y: H,   col: [70,  185, 170], r: 500 },   // bottom-right teal
      { x: W/2, y: H*0.6, col: [240, 230, 80], r: 380 },  // center yellow
    ];

    corners.forEach(({ x, y, col, r }) => {
      for (let i = r; i > 0; i -= 20) {
        let a = p.map(i, 0, r, 38, 0);
        p.noStroke();
        p.fill(col[0], col[1], col[2], a);
        p.ellipse(x, y, i * 2, i * 2);
      }
    });

    let mdx = (mx - W / 2) / W;
    let mdy = (my - H / 2) / H;

    triangles.forEach((tri) => {
      tri.ox += (mdx * tri.mouseStrength - tri.ox) * tri.mouseLag;
      tri.oy += (mdy * tri.mouseStrength - tri.oy) * tri.mouseLag;

      let driftX = p.cos(t * tri.driftFreqX + tri.phase) * tri.driftAmp;
      let driftY = p.sin(t * tri.driftFreqY + tri.phase * 1.3) * tri.driftAmp;

      let cx = W / 2 + tri.hx + tri.ox + driftX;
      let cy = H / 2 + tri.hy + tri.oy + driftY;

      let angle = tri.baseAngle + t * tri.rotSpeed + p.sin(t * 0.3 + tri.phase) * 0.18;

      drawSharpTriangle(cx, cy, tri.radius, angle, tri.col, tri.alpha);
    });

    // Film grain
    p.loadPixels();
    for (let i = 0; i < 8000; i++) {
      let x = p.floor(p.random(W));
      let y = p.floor(p.random(H));
      let idx = 4 * (y * W + x);
      let g = p.random(50);
      p.pixels[idx]     = p.min(255, p.pixels[idx]     + g);
      p.pixels[idx + 1] = p.min(255, p.pixels[idx + 1] + g);
      p.pixels[idx + 2] = p.min(255, p.pixels[idx + 2] + g);
    }
    p.updatePixels();
  };
});
